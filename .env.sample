# PostgreSQL Server Configuration
# These credentials are used by the postgis-local container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=whatever-password-is

# pg-shell Connection Configuration
# Default database to connect to when starting pgcli/psql without specifying a database
PGSHELL_DB=postgres

# pg-shell authentication - typically same as POSTGRES_USER/POSTGRES_PASSWORD
# You can reference the variables above or set different credentials if needed
PGSHELL_USER=${POSTGRES_USER}
PGSHELL_PASSWORD=${POSTGRES_PASSWORD}

# Host Machine Storage Root
# Base directory on your host machine for data and backup storage
# I like this to be in my home directory, but you can set it to whatever path you prefer
# Data will be stored in: ${HOST_DATA_FILE_ROOT}/data/postgis-local
# Backups will be stored in: ${HOST_DATA_FILE_ROOT}/backups/postgis-local
HOST_DATA_FILE_ROOT=/home/whatever-user-you-want